{
	"name": "create-fastify-app",
	"private": true,
	"description": "A lightweight, scalable authentication service featuring Fastify, Drizzle ORM, PostgreSQL, and TypeScript",
	"type": "module",
	"scripts": {
		"arch": "depcruise src --config .dependency-cruiser.cjs",
		"build:check": "bun build src/index.ts --outdir dist --target node --packages external",
		"check": "bun run verify",
		"ci": "bun run typecheck && bun run lint && bun run type-coverage && bun run knip && bun run arch && bun run spell && bun run secrets && bun run test && bun run build:check",
		"deps:upgrade": "ncu -i",
		"dev": "bun --watch src/app/server.ts",
		"format": "biome format --write .",
		"knip": "bunx --bun knip",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "husky || true",
		"secrets": "secretlint \"**/*\"",
		"spell": "cspell --no-progress \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\"",
		"start": "bun src/app/server.ts",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"type-coverage": "type-coverage --strict --at-least 100 --ignore-catch",
		"typecheck": "tsc --noEmit",
		"verify": "bun run typecheck && bun run lint:fix && bun run type-coverage && bun run knip && bun run spell && bun run test"
	},
	"dependencies": {
		"@fastify/compress": "^9.3.0",
		"@fastify/cookie": "^11.1.5",
		"@fastify/cors": "^11.3.1",
		"@fastify/rate-limit": "^11.2.1",
		"@fastify/swagger": "^9.9.2",
		"@fastify/swagger-ui": "^6.1.2",
		"fastify": "^5.12.7",
		"fastify-plugin": "^6.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@faker-js/faker": "^10.6.0",
		"@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
		"@types/bun": "^1.4.4",
		"cspell": "^10.4.0",
		"dependency-cruiser": "^18.7.0",
		"husky": "^9.1.7",
		"knip": "^6.43.0",
		"lint-staged": "^17.6.0",
		"npm-check-updates": "^23.1.1",
		"secretlint": "^13.1.0",
		"sort-package-json": "^4.1.0",
		"type-coverage": "^2.30.4",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": "24.x"
	}
}
