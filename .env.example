# Server
NODE_ENV=development
HOST=localhost
PORT=7164
LOG_LEVEL=info

# Secrets. In production EVERY secret below is REQUIRED: unique, at least 32 characters,
# and all different from each other. Generate each one with:
#   openssl rand -base64 48
#   bun -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
APP_SECRET=
AUTH_COOKIE_SECRET=
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=

# Cookies (optional). Unset COOKIE_SECURE = Secure only in production.
# AUTH_COOKIE_SAMESITE=lax      # lax | strict | none (none forces Secure)
# AUTH_COOKIE_DOMAIN=example.com
# COOKIE_SECURE=true

# Proxy. Set to true ONLY behind a proxy/load balancer you control, so the real client IP
# (not the proxy's) is used for rate limiting. Detected automatically on Vercel.
TRUST_PROXY=false

# Public URLs (optional). On Vercel these default from VERCEL_PROJECT_PRODUCTION_URL.
# SITE_ORIGIN=http://localhost:7164

# Frontend origins (optional)
# CLIENT_ORIGIN=http://localhost:3000
# CLIENT_ORIGINS=http://localhost:3000

# API
API_PREFIX=/api
API_VERSION=v1

# Rate limiting
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Request body size limit, in bytes
BODY_LIMIT_BYTES=1000000

# Security headers (CSP, HSTS, X-Frame-Options, ...)
ENABLE_SECURITY_HEADERS=true

# CSRF protection (double-submit cookie). Only relevant if the frontend relies on cookies
# for auth — a pure Bearer-token client is not vulnerable to CSRF and skips this check.
ENABLE_CSRF_PROTECTION=false

# CORS (allows the origins in CLIENT_ORIGINS, with credentials for the CSRF cookie)
ENABLE_CORS=true
CLIENT_ORIGINS=http://localhost:3000

# Response compression. On Vercel this is usually redundant — their edge network already
# compresses responses — so leave this off there unless you've measured a benefit.
ENABLE_COMPRESSION=true

# One JSON log line per request (method, path, status, duration)
ENABLE_REQUEST_LOGGING=true

# Interactive API docs generated from route schemas, served at /openapi
ENABLE_SWAGGER=true
